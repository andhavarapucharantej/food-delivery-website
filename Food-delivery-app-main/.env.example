# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_delivery?retryWrites=true&w=majority

# JWT Secret (minimum 32 characters for HS256)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_food_delivery_2026

# Seed endpoint secret for POST /api/seed (checked via x-seed-secret header)
SEED_SECRET=super_secret_seed_key_here_food_app_2026

# Seeded admin credentials (Admin: Charan)
ADMIN_EMAIL=charan@admin.com
ADMIN_PASSWORD=Bitcoin@100

# Delivery Simulation ("true" to automatically simulate delivery progression on GET /api/orders/[id])
SIMULATE_DELIVERY=true
